---
// Every file the site shows goes through this component: the whole file, no scrolling, the site's
// light or dark colors, and the compiler's diagnostics under the lines they point at.
import { renderFile, type InlineDiagnostic } from "./code-file.ts";

interface Props {
	name: string;
	contents: string;
	diagnostics?: InlineDiagnostic[];
}
const { name, contents, diagnostics = [] } = Astro.props;
const html = await renderFile(name, contents, diagnostics);
---

<Fragment set:html={html} />
