---
// A piece of the PHP an example compiles to, cut from the compiler's real output when the site is
// built. The example is compiled by the browser build of the compiler (public/compiler.wasm), which
// writes the same functions.php as `typedpress build`. An anchor that stops matching fails the build, so
// the page never shows code the compiler no longer writes.
//
// An example with npm dependencies compiles from its copy in .showcase/, where `pnpm showcase`
// installed its locked packages; the example directory itself never gets node_modules in CI.
import CodeFile from "./CodeFile.astro";
import { compileFiles, repo, site, sources } from "./examples.ts";
import { excerpt } from "./excerpt.ts";
import { toTypedPress } from "./names.ts";
import { existsSync } from "node:fs";
import path from "node:path";

interface Props {
	/** The directory under examples/. */
	example: string;
	/** The first line to show: the line containing this text. */
	from: string;
	/** The last line to show: the first line at or after `from` that is exactly this text. Defaults to "}". */
	toLine?: string;
	/** The name shown above the excerpt. */
	name?: string;
}
const { example, from, toLine = "}", name = "tp/app/functions.php" } = Astro.props;
const dir = path.join(repo, "examples", example);
const installed = path.join(site, ".showcase", example);
const needsPackages = existsSync(path.join(dir, "package-lock.json"));
if (needsPackages && !existsSync(path.join(installed, "node_modules"))) throw new Error(`examples/${example} imports npm packages; run \`pnpm showcase\` first`);
const { check, output } = await compileFiles(example, sources(needsPackages ? installed : dir));
if (!output) throw new Error(`examples/${example} does not compile: ${check.diagnostics.map((d) => d.message).join("; ")}`);
const text = excerpt(output.functionsPhp, { from, toLine });
---

<CodeFile name={name} contents={toTypedPress(text)} />
