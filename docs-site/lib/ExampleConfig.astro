---
// An example's config as the site shows it everywhere: read from examples/<name>, compiled by the
// browser build of the compiler, and rendered whole by CodeFile with the compiler's diagnostics
// inline. A page writes <ExampleConfig name="pantry" /> and never copies the file.
import { readFileSync } from "node:fs";
import path from "node:path";
import CodeFile from "./CodeFile.astro";
import { diagnosticsFor } from "./code-file.ts";
import { compileExample, repo } from "./examples.ts";

interface Props {
	/** The directory under examples/. */
	name: string;
	/** A source file of the example. Defaults to the config. */
	file?: string;
}
const { name, file = "typedpress.config.ts" } = Astro.props;
const contents = readFileSync(path.join(repo, "examples", name, file), "utf8");
const { check } = await compileExample(name);
---

<CodeFile name={file} contents={contents} diagnostics={diagnosticsFor(file, check.diagnostics)} />
