---
// A file from a committed pages render artifact (examples/<name>/zero/pages.json): the block markup,
// stylesheets and island bundles `first-pages build` wrote. The artifact stores each file base64;
// this decodes it when the site is built. CI fails when the artifact is older than the TSX, so the
// page shows what the pages compiler writes today.
//
// Request values in the markup are placeholders, U+E000 name U+E001, which WordPress fills per
// request. They are shown as ⟨name⟩ so they can be read.
import { readFileSync } from "node:fs";
import path from "node:path";

import CodeFile from "./CodeFile.astro";
import { repo } from "./examples.ts";
import { toFirst } from "./names.ts";

interface Props {
	/** The example directory under examples/. */
	example: string;
	/** A route's source file (`pages/notes/[slug]/page.tsx`): show its template. */
	route?: string;
	/** Or a file of the artifact by its path (`assets/island-….js`), or by a prefix of it. */
	file?: string;
	/** The name shown above the file. */
	name?: string;
}
const { example, route, file, name } = Astro.props;
const artifact = JSON.parse(readFileSync(path.join(repo, "examples", example, "zero/pages.json"), "utf8")) as {
	manifest: string;
	files: Record<string, string>;
};
const manifest = JSON.parse(artifact.manifest) as { routes: { source: string; template: string }[]; notFound: { source: string; template: string } };
let key: string | undefined;
if (route) key = [...manifest.routes, manifest.notFound].find((r) => r.source === route)?.template;
else if (file) key = Object.keys(artifact.files).find((f) => f === file || f.startsWith(file));
if (!key || !(key in artifact.files)) throw new Error(`examples/${example}/zero/pages.json has no ${route ?? file}`);
const text = Buffer.from(artifact.files[key]!, "base64").toString("utf8").replace(/\u{E000}([a-z][a-z0-9]*)\u{E001}/gu, "⟨$1⟩");
const shown = name ?? `first/pages.json → ${key}`;
---

<CodeFile name={toFirst(shown)} contents={toFirst(text)} />
