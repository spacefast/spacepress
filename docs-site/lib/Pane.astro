---
// One file excerpt with its name, highlighted.
import { highlight } from "../lib/highlight.ts";
import type { ResolvedPane } from "../lib/tour.ts";

interface Props {
  pane: ResolvedPane;
}
const { pane } = Astro.props;
---

<figure class="pane">
  <figcaption><code>{pane.label}</code></figcaption>
  <Fragment set:html={await highlight(pane.code, pane.lang)} />
</figure>

<style>
  .pane { margin: 0 0 0.75rem; }
  figcaption { font-size: 0.8rem; color: var(--blume-muted-foreground); margin: 0 0 0.3rem; }
  .pane :global(pre) { margin: 0; padding: 0.9rem 1rem; overflow: auto; border: 1px solid var(--blume-border); border-radius: 6px; background: #fafaf9; font: 0.8rem/1.5 var(--blume-font-mono); }
</style>
