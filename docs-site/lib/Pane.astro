---
// One excerpt of a tour stop: a named range of a source or of a generated file. It renders through
// the shared CodeFile, so it looks like every other file on the site and never scrolls.
import CodeFile from "./CodeFile.astro";
import type { ResolvedPane } from "./tour.ts";

interface Props {
	pane: ResolvedPane;
}
const { pane } = Astro.props;
---

<CodeFile name={pane.label} contents={pane.code} />
