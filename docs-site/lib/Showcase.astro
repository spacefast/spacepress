---
// An example in two parts. First its config, whole, rendered when the site is built: it is what
// the reader writes, so it never scrolls. Then an explorer with every file of the example and every
// file `first build` writes for it: a searchable tree, and a viewer of fixed height that scrolls.
// The viewer fetches a file from public/files/ when someone opens it. The open file is in the URL
// (#file=...), so it can be linked. A button runs the example in WordPress Playground.
import { readFileSync } from "node:fs";
import path from "node:path";
import { preloadFileTree } from "@pierre/trees/ssr";

import CodeFile from "./CodeFile.astro";
import { filesRoot, isWritten, manifest } from "./showcase.ts";

interface Props {
	/** The directory under examples/. */
	name: string;
}
const { name } = Astro.props;
const { app, files } = manifest(name);
const entry = "first.config.ts";
const written = files.filter((file) => isWritten(file.path));
const built = files.filter((file) => file.path.startsWith("first/"));
const plugins = "first/dist/wp-content/plugins";
const appPlugin = `${plugins}/first-app-${app}`;
const parents = (file: string) => file.split("/").slice(0, -1).map((_, i, parts) => parts.slice(0, i + 1).join("/"));
const options = {
	id: `files-${name}`,
	paths: files.map((file) => file.path),
	initialExpansion: "closed" as const,
	initialExpandedPaths: [...new Set([...written.flatMap((file) => parents(file.path)), "first", "first/dist", "first/dist/wp-content", plugins, appPlugin, `${appPlugin}/first/app`])],
	flattenEmptyDirectories: true,
	search: true,
	initialVisibleRowCount: 16,
};
const tree = preloadFileTree(options);
const config = files.find((file) => file.path === entry)!;
const configText = readFileSync(path.join(filesRoot, "blobs", `${config.blob}.txt`), "utf8");
const json = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");
const count = (n: number) => n.toLocaleString("en-US");
---

<section class="explorer not-prose" data-entry={entry} data-first-open={`${appPlugin}/first/app/functions.php`} data-manifest={`/files/${name}.json`} data-blueprint={`/files/${name}.blueprint.json`} aria-label={`examples/${name}`}>
	<div class="explorer-config">
		<CodeFile name={entry} contents={configText} />
	</div>
	<header class="explorer-bar">
		<span><strong>{count(files.length)}</strong> files: <strong>{written.length}</strong> you write, <strong>{count(built.length)}</strong> from <code>first build</code>. Every one opens.</span>
		<button class="explorer-run" type="button">Run in WordPress</button>
	</header>
	<div class="explorer-body">
		<nav class="explorer-tree" aria-label="Files">
			<Fragment set:html={`${tree.outerStart}${tree.shadowHtml}${tree.outerEnd}`} />
		</nav>
		<div class="explorer-file" aria-live="polite">
			<p class="explorer-note">Loading…</p>
			<div class="explorer-loaded" hidden></div>
		</div>
	</div>
	<div class="explorer-wordpress" hidden>
		<p class="explorer-wordpress-bar">
			<span>WordPress with this example's plugins, running in your browser through <a href="https://wordpress.org/playground/">WordPress Playground</a>.</span>
			<a class="explorer-wordpress-tab" target="_blank" rel="noopener">New tab ↗</a>
		</p>
		<iframe title={`WordPress running examples/${name}`}></iframe>
	</div>
	<script class="explorer-data" type="application/json" set:html={json({ ...options, paths: undefined })} />
</section>

<script>
	import { FileTree } from "@pierre/trees";
	import { File } from "@pierre/diffs";

	interface Entry { path: string; blob: string | null; size: number }
	const kb = (bytes: number) => `${(bytes / 1024).toFixed(bytes < 10240 ? 1 : 0)} KB`;
	const dark = () => document.documentElement.dataset.theme === "dark";

	for (const section of document.querySelectorAll<HTMLElement>(".explorer")) {
		const options = JSON.parse(section.querySelector<HTMLScriptElement>(".explorer-data")!.textContent!) as { id: string } & Record<string, unknown>;
		const loaded = section.querySelector<HTMLElement>(".explorer-loaded")!;
		const note = section.querySelector<HTMLElement>(".explorer-note")!;
		const viewerBox = section.querySelector<HTMLElement>(".explorer-file")!;
		let viewer: File | undefined;
		let current = "";
		let byPath = new Map<string, Entry>();

		const open = async (path: string, quiet = false) => {
			const file = byPath.get(path);
			if (!file || path === current) return;
			current = path;
			// The default file leaves the URL alone; one the reader picks goes in it.
			if (!quiet && location.hash !== `#file=${encodeURIComponent(path)}`) history.replaceState(null, "", `#file=${encodeURIComponent(path)}`);
			if (file.blob === null) {
				note.textContent = `${path} is a binary file (${kb(file.size)}). It is listed, not shown.`;
				note.hidden = false;
				loaded.hidden = true;
				return;
			}
			const contents = await (await fetch(`/files/blobs/${file.blob}.txt`)).text();
			if (current !== path) return;
			viewer?.cleanUp();
			loaded.replaceChildren();
			viewer = new File({ theme: { light: "pierre-light", dark: "pierre-dark" }, themeType: dark() ? "dark" : "light", overflow: "wrap" });
			viewer.render({ file: { name: path, contents, cacheKey: file.blob }, containerWrapper: loaded });
			note.hidden = true;
			loaded.hidden = false;
			viewerBox.scrollTop = 0;
		};

		// The tree is in the page already; the file list it was rendered from is fetched to hydrate it.
		void fetch(section.dataset.manifest!).then((response) => response.json()).then(({ files }: { files: Entry[] }) => {
			byPath = new Map(files.map((file) => [file.path, file]));
			const tree = new FileTree({
				...options,
				paths: files.map((file) => file.path),
				onSelectionChange: (selected: readonly string[]) => {
					const path = selected.at(-1);
					if (path && !path.endsWith("/")) void open(path);
				},
			});
			tree.hydrate({ fileTreeContainer: section.querySelector<HTMLElement>(`#${options.id}`)! });

			// #file=<path> opens that file and the folders above it. Without one, the app's compiled
			// PHP opens: the config is already on the page above.
			const fromHash = (initial = false) => {
				const match = /^#file=(.+)$/.exec(location.hash);
				if (!match && !initial) return;
				const path = match ? decodeURIComponent(match[1]!) : section.dataset.firstOpen!;
				if (!byPath.has(path) || path === current) return;
				const parts = path.split("/");
				for (let i = 1; i < parts.length; i++) {
					const folder = tree.getItem(`${parts.slice(0, i).join("/")}/`);
					if (folder && "expand" in folder) folder.expand();
				}
				tree.getItem(path)?.select();
				tree.scrollToPath(path, { focus: false });
				if (match) section.querySelector(".explorer-bar")!.scrollIntoView({ block: "start" });
				void open(path, !match);
			};
			window.addEventListener("hashchange", () => fromHash());
			fromHash(true);
		});

		// WordPress Playground, embedded on request: it downloads WordPress and PHP (about 30 MB).
		const run = section.querySelector<HTMLButtonElement>(".explorer-run")!;
		const wordpress = section.querySelector<HTMLElement>(".explorer-wordpress")!;
		run.addEventListener("click", () => {
			const url = `https://playground.wordpress.net/?blueprint-url=${encodeURIComponent(new URL(section.dataset.blueprint!, location.href).href)}`;
			wordpress.querySelector("iframe")!.src = url;
			wordpress.querySelector<HTMLAnchorElement>(".explorer-wordpress-tab")!.href = url;
			wordpress.hidden = false;
			run.disabled = true;
			wordpress.scrollIntoView({ behavior: "smooth", block: "start" });
		});

		new MutationObserver(() => viewer?.setThemeType(dark() ? "dark" : "light")).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
	}
</script>

<style>
	.explorer {
		margin: 1.5rem 0;
	}
	.explorer-config :global(diffs-container.code-file) {
		margin: 0 0 0.75rem;
	}
	.explorer-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		align-items: center;
		justify-content: space-between;
		padding: 0.5rem 0.5rem 0.5rem 0.8rem;
		border: 1px solid var(--blume-border);
		border-bottom: 0;
		border-radius: var(--blume-radius, 8px) var(--blume-radius, 8px) 0 0;
		font-size: 0.8rem;
		color: var(--blume-muted-foreground);
	}
	.explorer-bar strong {
		color: var(--blume-foreground);
		font-weight: 600;
	}
	.explorer-run {
		border: 1px solid var(--blume-accent);
		border-radius: 6px;
		padding: 0.3rem 0.7rem;
		background: var(--blume-accent);
		color: #fff;
		font: 500 0.8rem var(--blume-font-body);
		cursor: pointer;
	}
	.explorer-run:disabled {
		opacity: 0.6;
		cursor: default;
	}
	.explorer-body {
		display: grid;
		grid-template-columns: minmax(13rem, 19rem) minmax(0, 1fr);
		height: 30rem;
		border: 1px solid var(--blume-border);
		border-radius: 0 0 var(--blume-radius, 8px) var(--blume-radius, 8px);
		background: var(--blume-background);
		overflow: clip;
	}
	.explorer-tree {
		border-right: 1px solid var(--blume-border);
		min-height: 0;
	}
	.explorer-tree :global(file-tree-container) {
		display: block;
		height: 100%;
		color-scheme: light;
		--trees-font-size-override: 12.5px;
	}
	.explorer-file {
		min-width: 0;
		overflow: auto;
		color-scheme: light;
	}
	:global(:root[data-theme="dark"]) .explorer-tree :global(file-tree-container),
	:global(:root[data-theme="dark"]) .explorer-file {
		color-scheme: dark;
	}
	.explorer-file :global(diffs-container) {
		display: block;
		--diffs-font-family: var(--blume-font-mono);
		--diffs-font-size: 12px;
		--diffs-line-height: 18px;
	}
	.explorer-note {
		margin: 0;
		padding: 1.25rem;
		color: var(--blume-muted-foreground);
		font-size: 0.85rem;
	}
	.explorer-wordpress {
		margin-top: 0.75rem;
		border: 1px solid var(--blume-border);
		border-radius: var(--blume-radius, 8px);
		overflow: clip;
	}
	.explorer-wordpress-bar {
		display: flex;
		gap: 1rem;
		justify-content: space-between;
		margin: 0;
		padding: 0.5rem 0.8rem;
		border-bottom: 1px solid var(--blume-border);
		font-size: 0.8rem;
		color: var(--blume-muted-foreground);
	}
	.explorer-wordpress iframe {
		display: block;
		width: 100%;
		height: 38rem;
		border: 0;
		background: var(--blume-muted);
	}
	@media (max-width: 40rem) {
		.explorer-body {
			grid-template-columns: minmax(0, 1fr);
			grid-template-rows: 14rem minmax(0, 1fr);
			height: 40rem;
		}
		.explorer-tree {
			border-right: 0;
			border-bottom: 1px solid var(--blume-border);
		}
	}
</style>
