---
// One stop of the tour: prose, then the config excerpt beside what the compiler made of it.
import Pane from "./Pane.astro";
import type { ResolvedStop } from "../lib/tour.ts";

interface Props {
  stop: ResolvedStop;
  number: number;
}
const { stop, number } = Astro.props;

/** Backticks in the prose are code; everything else is text. */
function inline(text: string): string {
  const escape = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  return text
    .split(/(`[^`]+`)/)
    .map((part) => (part.startsWith("`") ? `<code>${escape(part.slice(1, -1))}</code>` : escape(part)))
    .join("");
}
---

<section class="stop" id={stop.slug} aria-labelledby={`${stop.slug}-title`}>
  <h2 id={`${stop.slug}-title`}><span class="n">{number}</span> {stop.title}</h2>
  {stop.prose.map((p) => <p set:html={inline(p)} />)}
  <div class="panes">
    <div class="in">
      <h3>You write</h3>
      <Pane pane={stop.config} />
      {stop.inputs.map((pane) => <Pane pane={pane} />)}
    </div>
    <div class="out">
      <h3><code>first build</code> writes</h3>
      {stop.outputs.map((pane) => <Pane pane={pane} />)}
    </div>
  </div>
</section>

<style>
  .stop { padding-top: 0.5rem; }
  .stop h2 { font-size: 1.35rem; font-weight: 650; margin: 2rem 0 0.5rem; }
  .stop p { margin: 0.5rem 0; }
  .n { display: inline-block; min-width: 1.6em; color: var(--blume-muted-foreground); font-weight: 500; }
  .panes { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.25rem; margin-top: 0.75rem; }
  .panes h3 { margin: 0 0 0.5rem; font-size: 0.95rem; color: var(--blume-muted-foreground); font-weight: 600; }
  @media (max-width: 56rem) { .panes { grid-template-columns: minmax(0, 1fr); } }
</style>
