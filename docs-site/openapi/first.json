				"operationId": "listRows",
				"summary": "List rows",
				"description": "Rows the user may read. `limit` defaults to 50 and is at most 200.",
				"responses": {
					"200": {
						"description": "The result, under `data`.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Data"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				},
				"parameters": [
					{
						"name": "collection",
						"in": "path",
						"required": true,
						"description": "The collection or table key from your config, for example `posts`.",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "where",
						"in": "query",
						"required": false,
						"description": "A JSON filter, for example `{\"status\":\"published\"}`.",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "status",
						"in": "query",
						"required": false,
						"description": "Shorthand for a filter on `status`.",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "orderBy",
						"in": "query",
						"required": false,
						"description": "Comma-separated columns. Put `-` before a column to sort it in descending order, for example `-publishedAt,title`.",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "limit",
						"in": "query",
						"required": false,
						"description": "How many rows to return.",
						"schema": {
							"type": "integer"
						}
					},
					{
						"name": "offset",
						"in": "query",
						"required": false,
						"description": "How many rows to skip.",
						"schema": {
							"type": "integer"
						}
					},
					{
						"name": "with",
						"in": "query",
						"required": false,
						"description": "Relations to load: `author,comments`, or a JSON object such as `{\"author\":true}`.",
						"schema": {
							"type": "string"
						}
					}
				]
			},
