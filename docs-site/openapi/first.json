{
	"openapi": "3.1.0",
	"info": {
		"title": "First REST API",
		"version": "0.3.0",
		"description": "Every First app serves these routes under `/wp-json/first/v1` on its WordPress site. The paths with `{collection}`, `{name}` and `{bucket}` exist once for each collection, table, action, global and file bucket your config defines.\n\nA successful response is JSON with the result under `data`. An error is an RFC 9457 problem document with `type`, `title`, `status`, `code` and `detail`, served as `application/problem+json`.\n\nRequests use the signed-in WordPress user: a cookie with a REST nonce, an application password, or a First Identity access token. Each collection's `access` rules decide what that user may do. The generated client in `first/_generated/client/` calls every route on this page for you."
	},
	"servers": [
		{
			"url": "https://example.space.fast/wp-json/first/v1",
			"description": "Your app's WordPress site"
		}
	],
	"tags": [
		{
			"name": "Collections",
			"description": "One set of routes for each collection and table in your config."
		},
		{
			"name": "Revisions",
			"description": "Saved versions of a row, for collections with revisions."
		},
		{
			"name": "Actions",
			"description": "Named server functions from `actions` in your config."
		},
		{
			"name": "Globals",
			"description": "Single records, such as site settings, from `globals` in your config."
		},
		{
			"name": "Media",
			"description": "WordPress media library uploads."
		},
		{
			"name": "Files",
			"description": "Private files in the buckets from `files` in your config."
		},
		{
			"name": "Auth",
			"description": "The signed-in user and First Identity sessions."
		},
		{
			"name": "Sync",
			"description": "Content files that sync with rows, for collections with `sync`."
		},
		{
			"name": "Services",
			"description": "Forms, search and checkout from `services` in your config."
		},
		{
			"name": "Schema",
			"description": "A description of the app."
		}
	],
	"paths": {
