---
// One tour: the stops of lib/stops.ts, cut from the compiled example at build time.
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import Stop from "../../lib/Stop.astro";
import { example } from "../../lib/examples.ts";
import { toFirst } from "../../lib/names.ts";
import { resolveTour } from "../../lib/tour.ts";
import { tours } from "../../lib/stops.ts";

export function getStaticPaths() {
	return tours.map((tour) => ({ params: { example: tour.example }, props: { tour } }));
}

const { tour } = Astro.props;
const compiled = await example(tour.example);
const stops = resolveTour(tour, compiled);
const files = Object.keys(compiled.files).length;
const migrations = compiled.output.migrations.length;
const { config } = data;
const title = toFirst(tour.title);
---

<PageLayout
	site={{ title: config.title, description: config.description }}
	logo={config.logo}
	favicon={config.favicon}
	navigation={data.navigation}
	fontCssVars={data.fontCssVars}
	themeMode={config.theme.mode}
	searchEnabled={config.search.enabled}
	siteUrl={config.site}
	ogEnabled={config.og.enabled}
	page={{ title: `${title} · First`, description: toFirst(tour.intro[0] ?? title), route: `/tour/${tour.example}` }}
>
	<main class="tour">
		<p class="crumbs"><a href="/tour">Tour</a> / {tour.example}</p>
		<h1>{title}</h1>
		{tour.intro.map((p) => <p class="lede">{toFirst(p)}</p>)}
		<p class="facts">
			<code>examples/{tour.example}</code>: {files} source file{files === 1 ? "" : "s"} in.
			{migrations} migration{migrations === 1 ? "" : "s"}, <code>schema.php</code>, <code>functions.php</code> and the typed client out.
			<a href={`/examples/${tour.example}`}>About this example</a>.
		</p>
		<nav class="stops" aria-label="Stops">
			<ol>
				{stops.map((stop) => <li><a href={`#${stop.slug}`}>{stop.title}</a></li>)}
			</ol>
		</nav>
		{stops.map((stop, i) => <Stop stop={stop} number={i + 1} />)}
	</main>
</PageLayout>

<style>
	.tour { max-width: 80rem; margin: 0 auto; padding: 2.5rem 1rem 4rem; }
	h1 { font-size: 2rem; font-weight: 700; margin: 0 0 0.5rem; }
	.crumbs, .facts, .lede { color: var(--blume-muted-foreground); }
	.crumbs { margin: 0; }
	a { color: var(--blume-accent); }
	.stops ol { columns: 2; column-gap: 2rem; padding-left: 1.2rem; margin: 0.5rem 0 1rem; list-style: decimal; }
	.stops li { break-inside: avoid; }
	@media (max-width: 56rem) { .stops ol { columns: 1; } }
</style>
