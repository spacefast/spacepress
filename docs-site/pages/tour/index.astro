---
// The tour: one page per walk through an example (lib/stops.ts).
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import { tours } from "../../lib/stops.ts";

const { config } = data;
---

<PageLayout
	site={{ title: config.title, description: config.description }}
	logo={config.logo}
	favicon={config.favicon}
	navigation={data.navigation}
	fontCssVars={data.fontCssVars}
	themeMode={config.theme.mode}
	searchEnabled={config.search.enabled}
	siteUrl={config.site}
	ogEnabled={config.og.enabled}
	page={{ title: "Tour · TypedPress", description: "Each piece of an example's typedpress.config.ts next to what typedpress build turns it into.", route: "/tour" }}
>
	<main class="tour">
		<h1>Tour</h1>
		<p class="lede">
			Each tour walks through one example in the repository. It shows a piece of the example's
			<code>typedpress.config.ts</code> next to what <code>typedpress build</code> made of it. The output was compiled
			when this site was built, by the compiler that runs in the <a href="/playground">playground</a>.
		</p>
		{tours.map((tour) => (
			<section>
				<h2><a href={`/tour/${tour.example}`}>{tour.title}</a></h2>
				{tour.intro.slice(0, 1).map((p) => <p>{p}</p>)}
				<ol>
					{tour.stops.map((stop) => <li><a href={`/tour/${tour.example}#${stop.slug}`}>{stop.title}</a></li>)}
				</ol>
			</section>
		))}
	</main>
</PageLayout>

<style>
	.tour { max-width: 48rem; margin: 0 auto; padding: 2.5rem 1rem 4rem; }
	h1 { font-size: 2rem; font-weight: 700; margin: 0 0 0.5rem; }
	h2 { font-size: 1.25rem; font-weight: 650; margin: 2rem 0 0.5rem; }
	.lede { color: var(--blume-muted-foreground); }
	a { color: var(--blume-accent); }
	ol { padding-left: 1.2rem; list-style: decimal; }
	p { margin: 0.5rem 0; }
</style>
