---
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
const plants = (await getCollection("plants")).sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<Site title="Plants">
  <h1>Plants</h1>
  <ul class="plants">
    {plants.map((p) => (
      <li>
        <a href={`/plants/${p.id}`}>{p.data.title}</a> <span class="family">{p.data.family}</span>
        {p.data.summary && <p>{p.data.summary}</p>}
      </li>
    ))}
  </ul>
</Site>
