---
import { getComments } from './client';
interface Props { collection: string; contentId: string }
const { contentId } = Astro.props;
const { open } = await getComments(contentId);
---
{open && <form class="ec-comment-form" action="/wp-comments-post.php" method="post" id="commentform"><h3>Leave a comment</h3><label class="ec-comment-form-field"><span>Name</span> <input name="author" required /></label><label class="ec-comment-form-field"><span>Email</span> <input name="email" type="email" required /></label><label class="ec-comment-form-field"><span>Comment</span> <textarea name="comment" required /></label><input type="hidden" name="comment_post_ID" value={contentId} /><input type="hidden" name="comment_parent" value="0" /><input type="hidden" name="redirect_to" value={`${Astro.url.origin}${Astro.url.pathname}#comments`} /><button class="ec-comment-form-submit" type="submit">Post comment</button></form>}
<style>form {display:grid; gap:1rem} label {display:grid; gap:.3rem} input,textarea,button {font:inherit; padding:.6rem} textarea {min-height:8rem}</style>
<script>
  document.addEventListener('click', event => {
    if (!(event.target instanceof HTMLElement)) return;
    const reply = event.target.closest('[data-comment-reply]');
    if (!(reply instanceof HTMLElement)) return;
    const parent = document.querySelector('#commentform input[name="comment_parent"]');
    const text = document.querySelector('#commentform textarea');
    if (parent instanceof HTMLInputElement) parent.value = reply.dataset.commentReply ?? '0';
    if (text instanceof HTMLTextAreaElement) text.focus();
  });
</script>
