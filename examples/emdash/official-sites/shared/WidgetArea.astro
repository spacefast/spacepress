---
import { getSite, getTaxonomyTermsWithCacheHint, getEmDashCollection } from './client';
import PortableText from './PortableText.astro';
interface Props { name: string }
const widgets = (await getSite()).widgets.find(area => area.name === Astro.props.name)?.widgets.filter(widget => widget.enabled !== false) ?? [];
const categories = (await getTaxonomyTermsWithCacheHint('category')).data;
const tags = (await getTaxonomyTermsWithCacheHint('tag')).data;
const { entries } = await getEmDashCollection('posts', { limit: 100 });
const archives = [...new Set(entries.flatMap(p => p.data.publishedAt ? [p.data.publishedAt.toISOString().slice(0,7)] : []))];
---
<div class="widget-area">{widgets.map(widget => <section class:list={["widget", widget.componentId?.replace("core:", "widget-")]}><h3 class="widget__title">{widget.title}</h3><div class="widget__content">{widget.type === 'content' && <PortableText value={widget.content} />}{widget.componentId === 'core:search' && <form class="widget-search" action="/search" method="get"><input class="widget-search__input" type="search" name="q" aria-label="Search posts" placeholder="Search" /><button class="widget-search__button">Search</button></form>}{widget.componentId === 'core:categories' && <ul>{categories.map(term => <li><a href={`/category/${term.slug}`}>{term.label}</a></li>)}</ul>}{widget.componentId === 'core:tags' && <ul>{tags.map(term => <li><a href={`/tag/${term.slug}`}>{term.label}</a></li>)}</ul>}{widget.componentId === 'core:recent-posts' && <ul>{entries.slice(0, typeof widget.props?.count === 'number' ? widget.props.count : 5).map(entry => <li><a href={`/posts/${entry.id}`}>{entry.data.title}</a></li>)}</ul>}{widget.componentId === 'core:archives' && <ul>{archives.map(month => <li><a href={`/posts?month=${month}`}>{month}</a></li>)}</ul>}</div></section>)}</div>
