{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "types": [],
    "jsx": "react-jsx",
    "jsxImportSource": "typedpress",
    "paths": {
      "typedpress": ["../../types/typedpress/index.d.ts"],
      "typedpress/app": ["../../types/typedpress/app.d.ts"],
      "typedpress/client": ["../../types/typedpress/client.d.ts"],
      "typedpress/jsx-runtime": ["../../types/typedpress/jsx-runtime.d.ts"],
      "typedpress/jsx-dev-runtime": ["../../types/typedpress/jsx-dev-runtime.d.ts"]
    },
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["typedpress.config.ts", "tp/**/*.ts", "tp/**/*.tsx"],
  "exclude": ["tp/dist"]
}
