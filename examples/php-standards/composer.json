{
    "require-dev": {
        "wp-coding-standards/wpcs": "3.4.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "check-layout": "phpcs --standard=WordPress --sniffs=Generic.WhiteSpace.ScopeIndent,PEAR.Functions.FunctionCallSignature,Generic.WhiteSpace.ArbitraryParenthesesSpacing,Squiz.Functions.FunctionDeclarationArgumentSpacing,WordPress.WhiteSpace.ControlStructureSpacing"
    },
    "license": "MIT"
}
