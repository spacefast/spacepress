<?xml version="1.0"?>
<ruleset name="SpacePress runtime">
    <description>WordPress Core coding standards for hand-written runtime PHP.</description>
    <rule ref="WordPress-Core"/>
    <!-- These namespaces map class names directly to file paths. -->
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>*/runtime/SpacePress/*</exclude-pattern>
        <exclude-pattern>*/runtime/identity/src/*</exclude-pattern>
        <exclude-pattern>*/runtime/spacepress-plugin/src/*</exclude-pattern>
    </rule>
</ruleset>
