{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "spacepress",
    "strict": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "spacepress": [
        "../../types/spacepress/index.d.ts"
      ],
      "spacepress/server": [
        "../../types/spacepress/server.d.ts"
      ],
      "spacepress/server/db": [
        "../../types/spacepress/server-db.d.cts"
      ],
      "spacepress/server/app": [
        "../../types/spacepress/server-app.d.ts"
      ],
      "spacepress/server/content": [
        "../../types/spacepress/server-content.d.ts"
      ],
      "spacepress/server/wp": [
        "../../types/spacepress/server-wp.d.ts"
      ],
      "spacepress/danger": [
        "../../types/spacepress/danger.d.ts"
      ],
      "spacepress/jsx-runtime": [
        "../../types/spacepress/jsx-runtime.d.ts"
      ],
      "spacepress/jsx-dev-runtime": [
        "../../types/spacepress/jsx-dev-runtime.d.ts"
      ],
      "@spacepress/client": [
        "../../packages/client/src/index.d.ts"
      ],
      "@spacepress/client/react": [
        "../../packages/client/src/react.d.ts"
      ],
      "react": [
        "../../types/spacepress/react.d.ts"
      ],
      "@spacepress/todo": [
        "../../packages/todo/src/index.ts"
      ],
      "@spacepress/todo/*": [
        "../../packages/todo/src/*.ts"
      ]
    }
  },
  "include": [
    "spacepress.config.ts",
    "sp/**/*.ts",
    "sp/**/*.tsx",
    "../../types/spacepress/assets.d.ts",
    "../../types/spacepress/db.d.cts"
  ],
  "exclude": [
    "sp/_generated/client",
    "sp/dist",
    "node_modules"
  ]
}
