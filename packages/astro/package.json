{
  "name": "@first/astro",
  "version": "0.1.0",
  "description": "A First site as the content source of an Astro site: build-time and live content collections, cache tags, signed webhooks, and EmDash's official templates unchanged.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./emdash": {
      "types": "./src/emdash/index.d.ts",
      "default": "./src/emdash/integration.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "astro",
    "astro-loader",
    "first",
    "wordpress"
  ],
  "dependencies": {
    "linkedom": "0.18.12"
  },
  "peerDependencies": {
    "astro": ">=7.4.0 <8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "astro": "7.4.5",
    "typescript": "5.9.3"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/spacefast/zero.git",
    "directory": "packages/astro"
  }
}
