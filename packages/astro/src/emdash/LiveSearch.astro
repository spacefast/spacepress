---
interface Props { placeholder?: string; collections?: string[]; class?: string; inputClass?: string; resultsClass?: string; resultClass?: string }
const { placeholder = 'Search', class: className, inputClass, resultsClass, resultClass } = Astro.props;
---
<first-live-search class={className} data-result-class={resultClass}>
  <form role="search" action="/search" method="get"><label><span class="sr-only">Search</span><input class={inputClass} type="search" name="q" placeholder={placeholder} aria-label="Search" autocomplete="off" /></label><button class="sr-only" type="submit">Search</button></form>
  <div class={resultsClass} data-results aria-live="polite" hidden></div>
</first-live-search>
<script>
  class FirstLiveSearch extends HTMLElement {
    connectedCallback() {
      const input = this.querySelector('input');
      const results = this.querySelector('[data-results]');
      if (!(input instanceof HTMLInputElement) || !(results instanceof HTMLElement)) return;
      let controller: AbortController | undefined;
      input.addEventListener('input', async () => {
        controller?.abort();
        controller = new AbortController();
        const query = input.value.trim();
        results.replaceChildren();
        results.hidden = !query;
        if (!query) return;
        results.textContent = 'Searching…';
        try {
          const response = await fetch(`/api/search?q=${encodeURIComponent(query)}`, { signal: controller.signal });
          if (!response.ok) throw new Error('Search failed.');
          const json: unknown = await response.json();
          const items = (json && typeof json === 'object' && Array.isArray(json.items) ? json.items : []).filter((i) => typeof i?.title === 'string' && typeof i?.path === 'string');
          results.replaceChildren();
          for (const item of items) {
            const anchor = document.createElement('a');
            anchor.href = item.path;
            anchor.className = this.dataset.resultClass ?? '';
            anchor.textContent = item.title;
            results.append(anchor);
          }
          if (!items.length) results.textContent = 'No results';
        } catch(error) { if (!(error instanceof DOMException && error.name === 'AbortError')) results.textContent = 'Search unavailable'; }
      });
      input.addEventListener('keydown', event => {
        if (event.key === 'Escape') { results.hidden = true; input.blur(); }
        if (event.key === 'ArrowDown') { event.preventDefault(); results.querySelector('a')?.focus(); }
      });
    }
  }
  if (!customElements.get('first-live-search')) customElements.define('first-live-search', FirstLiveSearch);
</script>
<style>first-live-search {display:block; position:relative} [data-results] {position:absolute; z-index:60; background:Canvas; color:CanvasText; padding:1rem; box-shadow:0 2px 10px #0002; min-width:100%} [data-results] :global(a) {display:block; padding:.5rem} .sr-only {position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0)}</style>
