---
// Written the way EmDash's templates are: everything from "emdash", nothing First-specific.
import { getEmDashCollection, getSiteSettings, getMenuWithCacheHint } from "emdash";
import { PortableText, WidgetArea } from "emdash/ui";
const { entries } = await getEmDashCollection("posts", { limit: 10 });
const settings = await getSiteSettings();
const { data: menu } = await getMenuWithCacheHint("primary");
---
<h1>{settings.title}</h1>
<nav>{menu?.items.map((i) => <a href={i.url}>{i.label}</a>)}</nav>
<ul>{entries.map((e) => <li><a href={`/posts/${e.id}`}>{e.data.title}</a> <span class="excerpt">{e.data.excerpt}</span></li>)}</ul>
<footer><WidgetArea name="footer" /></footer>
