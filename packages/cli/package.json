{
  "name": "typedpress",
  "version": "0.3.0",
  "description": "The TypedPress compiler and local WordPress development command, without a Rust toolchain",
  "license": "MIT",
  "homepage": "https://github.com/spacefast/zero/tree/main/packages/cli#readme",
  "bugs": "https://github.com/spacefast/zero/issues",
  "keywords": ["typedpress", "wordpress", "typescript", "backend", "compiler", "cli"],
