{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "spacepress",
    "types": ["node"],
    "paths": {
      "react": ["./node_modules/spacepress/types/react.d.ts"]
    }
  },
  "include": ["spacepress.config.ts", "*.client.ts", "sp"],
  "exclude": ["sp/dist"]
}
