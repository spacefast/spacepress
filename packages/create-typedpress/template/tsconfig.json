{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "typedpress",
    "types": ["node"],
    "paths": {
      "typedpress": ["./node_modules/typedpress/types/index.d.ts"],
      "typedpress/*": ["./node_modules/typedpress/types/*.d.ts"],
      "typedpress:db": ["./node_modules/typedpress/types/db.d.cts"],
      "php/wordpress": ["./node_modules/typedpress/types/wordpress.d.ts"]
    }
  },
  "include": ["typedpress.config.ts", "*.client.ts", "tp"],
  "exclude": ["tp/dist"]
}
