{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "typedpress": ["./node_modules/typedpress/types/index.d.ts"],
      "php/wordpress": ["./node_modules/typedpress/types/wordpress.d.ts"]
    }
  },
  "include": ["typedpress.config.ts", "client.ts", "*.client.ts", "tp/**/*.ts"]
}
