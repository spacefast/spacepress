{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "zero": ["./node_modules/@spacefast/zero-cli/types/index.d.ts"],
      "php/wordpress": ["./node_modules/@spacefast/zero-cli/types/wordpress.d.ts"]
    }
  },
  "include": ["zero.config.ts", "zero.gen.ts", "client.ts", "zero/client/**/*.ts"]
}
