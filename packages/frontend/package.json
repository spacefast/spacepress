{
  "name": "@typedpress/frontend",
  "version": "0.1.0",
  "description": "Build route-level browser assets and Tailwind styles for TypedPress pages",
  "license": "MIT",
  "homepage": "https://github.com/spacefast/zero/tree/main/packages/frontend#readme",
  "type": "module",
  "engines": { "node": ">=22.23.4" },
