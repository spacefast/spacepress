{
  "name": "@typedpress/frontend",
  "version": "0.1.0",
  "description": "Build route-level browser assets and Tailwind styles for TypedPress pages",
  "license": "MIT",
  "homepage": "https://github.com/spacefast/zero/tree/main/packages/frontend#readme",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "bin": {
    "typedpress-frontend": "./bin/typedpress-frontend.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:frameworks": "node --test test/frameworks.browser.mjs",
    "test:refresh": "node --test test/refresh.browser.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "5.2.0",
    "@vitejs/plugin-vue": "6.0.11",
    "vite": "8.2.1",
    "vite-plugin-solid": "2.11.17"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/spacefast/zero.git",
    "directory": "packages/frontend"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@kobalte/core": "0.13.14",
    "preact": "11.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "solid-js": "1.9.19",
    "vue": "3.5.45"
  }
}
