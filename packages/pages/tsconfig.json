{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023"],
    "types": ["node"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@spacefast/first-pages",
    "baseUrl": ".",
    "paths": {
      "first": ["../../types/first/index.d.ts"],
      "@spacefast/first-pages": ["./src/index.ts"],
      "@spacefast/first-pages/*": ["./src/*.ts"],
      "@spacefast/first-blocks": ["../blocks/src/index.ts"],
      "@spacefast/first-blocks/*": ["../blocks/src/*.ts"]
    }
  },
  "include": ["src", "tests/unit", "bin"]
}
