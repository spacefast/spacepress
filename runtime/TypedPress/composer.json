{
  "name": "spacefast/typedpress-runtime",
  "description": "Bundled Markdown, merge and S3 for TypedPress; HTML and block parsing come from WordPress core",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2",
    "async-aws/s3": "3.5.0",
    "rowbot/url": "4.2.1",
    "scrivo/highlight.php": "9.18.1.10",
    "wp-php-toolkit/markdown": "^0.10",
    "wp-php-toolkit/merge": "^0.10"
  },
  "replace": {
    "wp-php-toolkit/blockparser": "*",
    "wp-php-toolkit/bytestream": "*",
    "wp-php-toolkit/encoding": "*",
    "wp-php-toolkit/filesystem": "*",
    "wp-php-toolkit/html": "*",
    "wp-php-toolkit/http-client": "*",
    "wp-php-toolkit/xml": "*"
  },
  "config": {
    "platform": {
      "php": "8.2.30"
    },
    "sort-packages": true
  },
  "extra": {
    "strauss": {
      "namespace_prefix": "TypedPress\\Vendor\\",
      "classmap_prefix": "TypedPress_Vendor_",
      "constant_prefix": "TP_VENDOR_",
      "target_directory": "vendor-prefixed",
      "delete_vendor_packages": true,
      "exclude_from_copy": {
        "file_patterns": [
          "^wp-php-toolkit/data-liberation/(bin|CSS|EntityReader|EntityWriter|URL|vendor-patched)/",
          "^wp-php-toolkit/data-liberation/BlockMarkup/class-blockmarkupurlprocessor\\.php$",
          "^wp-php-toolkit/data-liberation/Importer/(?!class-importutils\\.php$)",
          "^wp-php-toolkit/data-liberation/class-importentity\\.php$",
          "^wp-php-toolkit/data-liberation/DataFormatConsumer/class-markupprocessorconsumer\\.php$",
          "^wp-php-toolkit/markdown/class-markdownimporter\\.php$"
        ]
      },
      "exclude_from_prefix": {
        "namespaces": [
          "TypedPress\\"
        ]
      },
      "exclude_constants": {
        "constants": [
          "ABSPATH",
          "WP_CONTENT_DIR",
          "WP_PLUGIN_DIR",
          "WP_CLI",
          "WP_UNINSTALL_PLUGIN",
          "ARRAY_A",
          "DS"
        ]
      },
      "override_autoload": {
        "wp-php-toolkit/data-liberation": {
          "classmap": [
            "."
          ],
          "exclude-from-classmap": [
            "/Tests/",
            "/bin/"
          ]
        },
        "wp-php-toolkit/markdown": {
          "classmap": [
            "."
          ],
          "exclude-from-classmap": [
            "/Tests/",
            "/bin/",
            "/vendor-patched/symfony/yaml/Command/",
            "/vendor-patched/webuni/front-matter/src/Haml/",
            "/vendor-patched/webuni/front-matter/src/Pug/",
            "/vendor-patched/webuni/front-matter/src/Twig/"
          ]
        },
        "wp-php-toolkit/merge": {
          "classmap": [
            "."
          ]
        }
      }
    }
  }
}
