{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"rootDir": ".",
		"baseUrl": ".",
		"noEmit": true,
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"emitDeclarationOnly": false
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"**/*.js",
		"**/*.jsx"
	],
	"exclude": [
		"**/build",
		"**/node_modules",
		"**/*.test.ts",
		"**/*.test.tsx",
		"**/*.spec.ts",
		"**/test/**",
		"**/*.stories.tsx",
		"**/stories/**",
		"**/*.mdx",
		"wp-journey/**"
	]
}
