---
// The docs, in the README's order, then the rest alphabetically.
import { getCollection } from "astro:content";

interface Props {
  current: string;
}
const { current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const order = [
  "config-api",
  "examples",
  "wp-plugins",
  "identity-api",
  "identity-security",
  "config-migration",
  "runtime-contract",
  "compiler-diagnostics",
];
const docs = await getCollection("docs");
const titles = new Map(docs.map((d) => [d.id, /^#\s+(.+)$/m.exec(d.body ?? "")?.[1] ?? d.id]));
const ids = [...order.filter((id) => titles.has(id)), ...[...titles.keys()].filter((id) => !order.includes(id)).sort()];
---

<nav class="docs-nav" aria-label="Docs">
  <a href={`${base}/docs`} aria-current={current === "" ? "page" : undefined}>README</a>
  {ids.map((id) => <a href={`${base}/docs/${id}`} aria-current={current === id ? "page" : undefined}>{titles.get(id)}</a>)}
</nav>

<style>
  .docs-nav { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.92rem; position: sticky; top: 1rem; align-self: start; }
  .docs-nav a { color: var(--muted); text-decoration: none; padding: 0.15rem 0; }
  .docs-nav a[aria-current="page"] { color: var(--ink); font-weight: 600; }
  @media (max-width: 56rem) { .docs-nav { position: static; flex-direction: row; flex-wrap: wrap; gap: 0.3rem 0.9rem; } }
</style>
