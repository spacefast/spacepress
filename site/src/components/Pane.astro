---
// One file excerpt with its name, highlighted.
import { Code } from "astro:components";
import type { ResolvedPane } from "../lib/tour.ts";

interface Props {
  pane: ResolvedPane;
}
const { pane } = Astro.props;
---

<figure class="pane">
  <figcaption><code>{pane.label}</code></figcaption>
  <Code code={pane.code} lang={pane.lang} theme="github-light" />
</figure>

<style>
  .pane { margin: 0 0 0.75rem; }
  figcaption { font-size: 0.8rem; color: var(--muted); margin: 0 0 0.3rem; }
</style>
