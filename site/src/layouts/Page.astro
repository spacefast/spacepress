---
// One layout for every page: the header with the site's sections, the content, a small footer.
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const here = Astro.url.pathname.replace(/\/$/, "");
const sections = [
  { href: `${base}/tour`, label: "Tour" },
  { href: `${base}/docs`, label: "Docs" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === "Zero" ? title : `${title} · Zero`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="6" fill="#111"/><text x="16" y="23" font-family="ui-monospace,monospace" font-size="20" font-weight="700" text-anchor="middle" fill="#fff">0</text></svg>')}`} />
  </head>
  <body>
    <header class="top">
      <a class="brand" href={`${base}/`}>Zero</a>
      <nav aria-label="Sections">
        {sections.map((s) => <a href={s.href} aria-current={here === s.href || here.startsWith(`${s.href}/`) ? "page" : undefined}>{s.label}</a>)}
        <a href="https://github.com/spacefast/zero">GitHub</a>
      </nav>
    </header>
    <slot />
    <footer class="bottom">
      <p>Zero is MIT licensed; what runs inside WordPress is GPL-2.0-or-later. <a href="https://spacefast.com">Spacefast</a>.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #161616;
    --muted: #5e5e5e;
    --line: #e4e4e4;
    --paper: #fff;
    --tint: #f6f6f4;
    --accent: #0a58ca;
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    --sans: system-ui, -apple-system, "Segoe UI", sans-serif;
    color-scheme: light;
  }
  * { box-sizing: border-box; }
  html { font-family: var(--sans); color: var(--ink); background: var(--paper); line-height: 1.55; -webkit-text-size-adjust: 100%; }
  body { margin: 0; min-height: 100dvh; display: flex; flex-direction: column; }
  a { color: var(--accent); }
  code, pre, kbd { font-family: var(--mono); font-size: 0.92em; }
  code:not(pre code) { background: var(--tint); padding: 0.05em 0.3em; border-radius: 3px; }
  main { flex: 1; width: 100%; max-width: 72rem; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
  main.prose { max-width: 46rem; }
  h1, h2, h3 { line-height: 1.2; letter-spacing: -0.01em; }
  h1 { font-size: 2rem; margin: 0 0 0.5rem; }
  h2 { font-size: 1.35rem; margin: 2.5rem 0 0.5rem; }
  h3 { font-size: 1.1rem; margin: 1.5rem 0 0.25rem; }
  p { margin: 0.6rem 0; }
  .lede { color: var(--muted); font-size: 1.1rem; }
  pre.astro-code, pre { margin: 0; padding: 0.9rem 1rem; overflow: auto; border: 1px solid var(--line); border-radius: 6px; background: var(--tint); font-size: 0.82rem; line-height: 1.5; }
  pre.astro-code { background: var(--tint) !important; }
  table { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: 0.95rem; }
  th, td { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  header.top { display: flex; align-items: center; gap: 1.5rem; padding: 0.9rem 1.25rem; border-bottom: 1px solid var(--line); }
  header.top .brand { font-weight: 700; color: var(--ink); text-decoration: none; font-size: 1.1rem; }
  header.top nav { display: flex; gap: 1.1rem; margin-left: auto; }
  header.top nav a { color: var(--muted); text-decoration: none; }
  header.top nav a[aria-current="page"] { color: var(--ink); font-weight: 600; }
  footer.bottom { border-top: 1px solid var(--line); padding: 1rem 1.25rem; color: var(--muted); font-size: 0.9rem; }
  footer.bottom p { margin: 0; }
  main.docs { display: grid; grid-template-columns: 14rem minmax(0, 1fr); gap: 2.5rem; }
  main.docs .doc { max-width: 46rem; min-width: 0; }
  main.docs .doc h1 { margin-top: 0; }
  main.docs .doc pre { margin: 0.75rem 0; }
  main.docs .doc img { max-width: 100%; }
  @media (max-width: 56rem) { main.docs { grid-template-columns: minmax(0, 1fr); } }
</style>
