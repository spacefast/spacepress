---
// The docs index is the README: the front page of the repository, with its links pointing here.
import { readFileSync } from "node:fs";
import path from "node:path";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import Page from "../../layouts/Page.astro";
import DocsNav from "../../components/DocsNav.astro";
import { remarkRepoLinks } from "../../lib/links.ts";

const repo = path.resolve("..");
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const processor = await createMarkdownProcessor({
  shikiConfig: { theme: "github-light" },
  remarkPlugins: [[remarkRepoLinks, { base, repo }]],
});
const readme = readFileSync(path.join(repo, "README.md"), "utf8");
const { code } = await processor.render(readme, { fileURL: new URL(`file://${path.join(repo, "README.md")}`) });
---

<Page title="Docs" description="Zero's documentation: the README, the zero.config.ts API, the examples, plugins, identity, migration and the runtime contract.">
  <main class="docs">
    <DocsNav current="" />
    <article class="doc" set:html={code} />
  </main>
</Page>
