---
import Page from "../../layouts/Page.astro";
import Stop from "../../components/Stop.astro";
import { example } from "../../lib/examples.ts";
import { resolveTour } from "../../lib/tour.ts";
import { tours } from "../../tour/stops.ts";

export function getStaticPaths() {
  return tours.map((tour) => ({ params: { example: tour.example }, props: { tour } }));
}

const { tour } = Astro.props;
const compiled = await example(tour.example);
const stops = resolveTour(tour, compiled);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const files = Object.keys(compiled.files).length;
const migrations = compiled.output.migrations.length;
---

<Page title={tour.title} description={tour.intro[0] ?? tour.title}>
  <main>
    <p class="crumbs"><a href={`${base}/tour`}>Tour</a> / {tour.example}</p>
    <h1>{tour.title}</h1>
    {tour.intro.map((p) => <p class="lede">{p}</p>)}
    <p class="facts">
      <code>examples/{tour.example}</code>: {files} source file{files === 1 ? "" : "s"} in;
      {migrations} migration{migrations === 1 ? "" : "s"}, <code>schema.php</code>,
      <code>functions.php</code> and the typed client out.
      <a href={`https://github.com/spacefast/zero/tree/main/examples/${tour.example}`}>Source on GitHub</a>.
    </p>
    <nav class="stops" aria-label="Stops">
      <ol>
        {stops.map((stop) => <li><a href={`#${stop.slug}`}>{stop.title}</a></li>)}
      </ol>
    </nav>
    {stops.map((stop, i) => <Stop stop={stop} number={i + 1} />)}
  </main>
</Page>

<style>
  .crumbs { color: var(--muted); margin: 0; }
  .facts { color: var(--muted); font-size: 0.95rem; }
  .stops ol { columns: 2; column-gap: 2rem; padding-left: 1.2rem; margin: 0.5rem 0 1rem; }
  .stops li { break-inside: avoid; }
  @media (max-width: 56rem) { .stops ol { columns: 1; } }
</style>
