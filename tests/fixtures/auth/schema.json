{
    "version": 3,
    "runtime": "0.3",
    "name": "club",
    "admin": false,
    "site": {
        "uidPrefix": "zr_"
    },
    "locales": null,
    "media": {
        "sizes": []
    },
    "auth": {
        "collection": "members",
        "guests": true,
        "accessTtl": 300,
        "refreshTtl": 2592000
    },
    "files": [],
    "jobs": [],
    "webhooks": [],
    "collections": {
        "notes": {
            "key": "notes",
            "label": "Notes",
            "editor": false,
            "drafts": false,
            "revisions": true,
            "comments": false,
            "uid": false,
            "sync": null,
            "auth": false,
            "agents": true,
            "localized": false,
            "title": null,
            "content": null,
            "slug": null,
            "primaryKey": "id",
            "columns": {
                "id": {
                    "type": "integer",
                    "primaryKey": true,
                    "autoIncrement": true,
                    "notNull": true
                },
                "body": {
                    "type": "text",
                    "notNull": true
                },
                "memberId": {
                    "type": "integer",
                    "references": {
                        "collection": "members",
                        "column": "id",
                        "onDelete": "restrict"
                    }
                }
            },
            "relations": {
                "memberId": {
                    "kind": "one",
                    "collection": "members",
