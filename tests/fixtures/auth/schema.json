                    "to": "id",
                    "optional": true
                }
            },
            "hooks": [],
            "beforeCreateFills": [],
            "access": {
                "read": {
                    "role": "anyone"
                },
                "create": {
                    "role": "authenticated"
                },
                "update": {
                    "role": "authenticated"
                },
                "delete": {
                    "role": "editor"
                }
            },
            "api": {
                "list": true,
                "get": true,
                "create": true,
                "update": true,
                "delete": true
            },
            "wp": null,
            "table": "first_notes"
        },
        "members": {
            "key": "members",
            "label": "Members",
            "editor": false,
            "drafts": false,
            "revisions": false,
            "comments": false,
            "uid": false,
            "sync": null,
            "auth": true,
            "agents": true,
            "localized": false,
            "title": null,
            "content": null,
            "slug": null,
            "primaryKey": "id",
            "columns": {
                "id": {
                    "type": "integer",
                    "primaryKey": true,
                    "autoIncrement": true,
                    "notNull": true
                },
                "email": {
                    "type": "email",
                    "notNull": true,
                    "unique": true,
                    "rules": {
                        "max": 191
                    }
                },
                "name": {
                    "type": "text",
                    "notNull": true,
                    "rules": {
                        "max": 80
                    }
                },
                "plan": {
                    "type": "text",
                    "notNull": true,
                    "enum": [
                        "free",
                        "pro"
                    ],
                    "default": {
                        "value": "free"
                    }
                },
                "billing": {
                    "type": "group",
                    "fields": {
                        "city": {
                            "type": "text"
                        },
                        "tier": {
                            "type": "text",
                            "notNull": true,
                            "access": {
                                "update": {
                                    "role": "admin"
                                }
                            }
                        }
                    }
                },
                "profile": {
                    "type": "group",
                    "fields": {
                        "bio": {
                            "type": "text"
                        },
                        "vip": {
                            "type": "group",
                            "notNull": true,
                            "fields": {
                                "level": {
                                    "type": "text",
                                    "notNull": true,
                                    "access": {
                                        "update": {
                                            "role": "admin"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "role": {
                    "type": "text",
                    "notNull": true,
                    "enum": [
                        "guest",
                        "subscriber",
                        "author",
                        "editor",
                        "admin"
                    ],
                    "default": {
                        "value": "subscriber"
                    },
                    "access": {
                        "update": {
                            "role": "admin"
                        }
                    },
                    "system": true
                },
                "passwordHash": {
                    "type": "text",
                    "hidden": true,
                    "system": true
                },
                "suspendedAt": {
                    "type": "timestamp",
                    "hidden": true,
                    "system": true
                },
                "guest": {
                    "type": "boolean",
                    "hidden": true,
                    "system": true
                }
            },
            "relations": {
                "notes": {
                    "kind": "many",
                    "collection": "notes",
                    "from": "id",
                    "to": "memberId",
                    "optional": false
                }
            },
            "hooks": [],
            "beforeCreateFills": [],
            "access": {
                "read": {
                    "self": true
                },
                "create": {
                    "role": "anyone"
                },
                "update": {
                    "self": true
                },
                "delete": {
                    "role": "admin"
                }
            },
            "api": {
                "list": true,
                "get": true,
                "create": true,
                "update": true,
                "delete": true
            },
            "wp": null,
            "table": "first_members"
        }
    },
    "globals": [],
    "actions": []
}
