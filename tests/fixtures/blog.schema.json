{
    "version": 3,
    "runtime": "0.3",
    "name": "blog",
    "admin": false,
    "site": {
        "uidPrefix": "zr_"
    },
    "locales": null,
    "media": {
        "sizes": []
    },
    "auth": {
        "collection": null,
        "guests": true,
        "accessTtl": 300,
        "refreshTtl": 2592000
    },
    "files": [],
    "jobs": [],
    "webhooks": [],
    "collections": {
        "authors": {
            "key": "authors",
            "label": "Authors",
            "editor": true,
            "drafts": true,
            "revisions": true,
            "comments": false,
            "uid": false,
            "sync": null,
            "auth": false,
            "agents": true,
            "localized": false,
            "title": "name",
            "content": null,
            "slug": null,
            "primaryKey": "id",
            "columns": {
                "id": {
                    "type": "integer",
                    "primaryKey": true,
                    "autoIncrement": true,
                    "notNull": true
                },
                "name": {
                    "type": "text",
                    "notNull": true,
                    "rules": {
                        "max": 80
                    }
                },
                "email": {
                    "type": "email",
                    "notNull": true,
                    "unique": true,
                    "rules": {
                        "max": 191
                    }
                },
                "bio": {
                    "type": "text",
                    "multiline": true,
                    "rules": {
                        "max": 500
                    }
                },
                "avatar": {
                    "type": "media",
                    "accept": "image"
                },
                "userId": {
                    "type": "integer"
                },
                "status": {
                    "type": "text",
                    "notNull": true,
                    "enum": [
                        "draft",
                        "published",
                        "scheduled"
                    ],
                    "default": {
                        "value": "published"
                    },
                    "system": true
                },
                "publishedAt": {
                    "type": "timestamp",
                    "system": true
                }
            },
            "relations": {
                "posts": {
                    "kind": "many",
                    "collection": "posts",
                    "from": "id",
                    "to": "authorId",
                    "optional": false
                }
            },
            "hooks": [],
            "beforeCreateFills": [],
            "access": {
                "read": {
                    "role": "anyone"
                },
                "create": {
                    "role": "admin"
                },
                "update": {
                    "role": "admin"
                },
                "delete": {
                    "role": "admin"
                }
            },
            "api": {
                "list": true,
                "get": true,
                "create": true,
                "update": true,
                "delete": true
            },
            "wp": {
                "postType": "first_authors",
                "groupKey": "group_first_authors",
                "metaPrefix": "first_",
                "fieldKeyPrefix": "field_first_authors_"
            },
            "table": null
        },
        "posts": {
            "key": "posts",
            "label": "Posts",
            "editor": true,
            "drafts": true,
            "revisions": true,
            "comments": false,
            "uid": false,
            "sync": null,
            "auth": false,
            "agents": true,
            "localized": false,
            "title": "title",
            "content": "body",
            "slug": "slug",
            "primaryKey": "id",
            "columns": {
                "id": {
                    "type": "integer",
                    "primaryKey": true,
                    "autoIncrement": true,
                    "notNull": true
                },
                "title": {
                    "type": "text",
                    "notNull": true,
                    "rules": {
                        "min": 1,
                        "max": 120
                    }
                },
                "slug": {
                    "type": "slug",
                    "unique": true,
                    "source": "title"
                },
                "body": {
                    "type": "richText"
                },
                "excerpt": {
                    "type": "text",
                    "multiline": true,
                    "rules": {
                        "max": 300
                    }
                },
                "cover": {
                    "type": "media",
                    "accept": "image"
                },
                "tags": {
                    "type": "select",
                    "multiple": true,
                    "enum": [
                        "news",
                        "guide",
                        "release"
                    ],
                    "notNull": true,
                    "default": {
                        "value": [],
                        "json": "[]"
                    }
                },
                "authorId": {
                    "type": "integer",
                    "references": {
                        "collection": "authors",
                        "column": "id",
                        "onDelete": "set null"
                    }
                },
                "seo": {
                    "type": "group",
                    "fields": {
                        "metaTitle": {
                            "type": "text",
                            "rules": {
                                "max": 70
                            }
                        },
                        "metaDescription": {
                            "type": "text",
                            "rules": {
                                "max": 160
                            }
                        },
                        "noindex": {
                            "type": "boolean",
                            "notNull": true,
                            "default": {
                                "value": false
                            }
                        }
                    }
                },
                "gallery": {
                    "type": "repeater",
                    "rules": {
                        "max": 12
                    },
                    "fields": {
                        "image": {
                            "type": "media",
                            "accept": "image",
                            "notNull": true
                        },
                        "caption": {
                            "type": "text",
                            "rules": {
                                "max": 120
                            }
                        }
                    }
                },
                "sections": {
                    "type": "blocks",
                    "layouts": {
                        "hero": {
                            "heading": {
                                "type": "text",
                                "notNull": true,
                                "rules": {
                                    "max": 80
                                }
                            },
                            "image": {
                                "type": "media",
                                "accept": "image"
                            }
                        },
                        "quote": {
                            "text": {
                                "type": "text",
                                "multiline": true,
                                "notNull": true
                            },
                            "cite": {
                                "type": "text",
                                "rules": {
                                    "max": 80
                                }
                            }
                        }
                    }
                },
                "createdAt": {
                    "type": "timestamp",
                    "notNull": true,
                    "default": {
                        "now": true
                    }
                },
                "updatedAt": {
                    "type": "timestamp",
                    "notNull": true,
                    "default": {
                        "now": true
                    },
                    "onUpdate": {
                        "now": true
                    }
                },
                "status": {
                    "type": "text",
                    "notNull": true,
                    "enum": [
                        "draft",
                        "published",
                        "scheduled"
                    ],
                    "default": {
                        "value": "published"
                    },
                    "system": true
                },
                "publishedAt": {
                    "type": "timestamp",
                    "system": true
                }
            },
            "relations": {
                "author": {
                    "kind": "one",
                    "collection": "authors",
                    "from": "authorId",
                    "to": "id",
                    "optional": true
                },
                "comments": {
                    "kind": "many",
                    "collection": "comments",
                    "from": "id",
                    "to": "postId",
                    "optional": false
                }
            },
            "hooks": {
                "beforeCreate": "posts__beforeCreate"
            },
            "beforeCreateFills": [],
            "access": {
                "read": {
                    "fn": "posts__access__read"
                },
                "create": {
                    "role": "author"
                },
                "update": {
                    "fn": "posts__access__update"
                },
                "delete": {
                    "role": "editor"
                }
            },
            "api": {
                "list": true,
                "get": true,
                "create": true,
                "update": true,
                "delete": true
            },
            "wp": {
                "postType": "first_posts",
                "groupKey": "group_first_posts",
                "metaPrefix": "first_",
                "fieldKeyPrefix": "field_first_posts_"
            },
            "table": null
        },
        "comments": {
            "key": "comments",
            "label": "Comments",
            "editor": false,
            "drafts": false,
            "revisions": false,
            "comments": false,
            "uid": false,
            "sync": null,
            "auth": false,
            "agents": true,
            "localized": false,
            "title": null,
            "content": null,
            "slug": null,
            "primaryKey": "id",
            "columns": {
                "id": {
                    "type": "integer",
                    "primaryKey": true,
                    "autoIncrement": true,
                    "notNull": true
                },
                "postId": {
                    "type": "integer",
                    "notNull": true,
                    "references": {
                        "collection": "posts",
                        "column": "id",
                        "onDelete": "cascade"
                    }
                },
                "name": {
                    "type": "text",
                    "notNull": true,
                    "rules": {
                        "max": 60
                    }
                },
                "body": {
                    "type": "text",
                    "multiline": true,
                    "notNull": true,
                    "rules": {
                        "min": 1,
                        "max": 2000,
                        "validate": "comments__validate__body"
                    }
                },
                "approved": {
                    "type": "boolean",
                    "notNull": true,
                    "default": {
                        "value": false
                    }
                },
                "createdAt": {
                    "type": "timestamp",
                    "notNull": true,
                    "default": {
                        "now": true
                    }
                }
            },
            "relations": {
                "post": {
                    "kind": "one",
                    "collection": "posts",
                    "from": "postId",
                    "to": "id",
                    "optional": false
                }
            },
            "hooks": {
                "afterCreate": "comments__afterCreate"
            },
            "beforeCreateFills": [],
            "access": {
                "read": {
                    "fn": "comments__access__read"
                },
                "create": {
                    "role": "anyone"
                },
                "update": {
                    "role": "editor"
                },
                "delete": {
                    "role": "editor"
                }
            },
            "api": {
                "list": true,
                "get": true,
                "create": true,
                "update": true,
                "delete": true
            },
            "wp": null,
            "table": "first_comments"
        }
    },
    "globals": {
        "settings": {
            "label": "Site settings",
            "agents": true,
            "fields": {
                "siteTitle": {
                    "type": "text",
                    "notNull": true,
                    "default": {
                        "value": "My blog"
                    },
                    "rules": {
                        "max": 80
                    }
                },
                "tagline": {
                    "type": "text",
                    "rules": {
                        "max": 160
                    }
                },
                "postsPerPage": {
                    "type": "integer",
                    "notNull": true,
                    "default": {
                        "value": 10
                    },
                    "rules": {
                        "min": 1,
                        "max": 50
                    }
                },
                "social": {
                    "type": "repeater",
                    "fields": {
                        "label": {
                            "type": "text",
                            "notNull": true,
                            "rules": {
                                "max": 40
                            }
                        },
                        "href": {
                            "type": "url",
                            "notNull": true
                        }
                    }
                }
            },
            "access": {
                "read": {
                    "role": "anyone"
                },
                "update": {
                    "role": "editor"
                }
            },
            "wp": {
                "postId": "first_global_settings",
                "menuSlug": "first-global-settings",
                "groupKey": "group_first_global_settings",
                "fieldKeyPrefix": "field_first_global_settings_",
                "optionPrefix": "first_global_settings_"
            }
        }
    },
    "actions": {
        "approveComment": {
            "input": {
                "id": {
                    "type": "integer",
                    "notNull": true
                }
            },
            "handler": "action__approveComment",
            "access": {
                "role": "editor"
            },
            "agents": true,
            "idempotent": false,
            "signature": null,
            "readonly": false,
            "destructive": false,
            "output": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": [
                            "number",
                            "null"
                        ]
                    },
                    "postId": {
                        "type": [
                            "number",
                            "null"
                        ]
                    },
                    "name": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    },
                    "approved": {
                        "type": "boolean"
                    },
                    "createdAt": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "postId",
                    "name",
                    "body",
                    "approved",
                    "createdAt"
                ]
            }
        },
        "publishedCount": {
            "input": [],
            "handler": "action__publishedCount",
            "access": {
                "role": "anyone"
            },
            "agents": true,
            "idempotent": false,
            "signature": null,
            "readonly": false,
            "destructive": false,
            "output": {
                "type": "object",
                "properties": {
                    "count": {
                        "type": [
                            "number",
                            "null"
                        ]
                    }
                },
                "required": [
                    "count"
                ]
            }
        }
    }
}
