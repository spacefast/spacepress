    "media": {
        "sizes": {
            "thumb": {
                "width": 300,
                "height": 300,
                "fit": "cover"
            },
            "wide": {
                "width": 1600,
                "height": null,
                "fit": "inside"
            }
        }
    },
    "auth": {
        "collection": "members",
        "guests": true,
        "accessTtl": 300,
        "refreshTtl": 2592000
    },
    "files": {
        "decks": {
            "accept": [
                "application/pdf",
                "image/*"
            ],
            "maxBytes": 20000000,
            "access": {
                "read": {
                    "owner": true
                },
                "create": {
                    "fn": "files__decks__access__create"
                },
                "delete": {
                    "owner": true
                }
            }
        }
    },
    "jobs": {
        "sendWelcome": {
            "input": {
                "email": {
                    "type": "email",
                    "notNull": true
                },
                "data": {
                    "type": "group",
                    "fields": {
                        "label": {
                            "type": "text",
                            "default": {
                                "value": "welcome"
                            }
                        },
                        "payload": {
                            "type": "json"
                        }
                    }
                },
                "payload": {
                    "type": "json",
                    "notNull": true
                }
            },
            "handler": "job__sendWelcome",
            "retries": 5,
            "agents": true
        }
    },
    "webhooks": [
        {
            "url": {
                "env": "HOOK_URL"
            },
            "secret": {
                "env": "HOOK_SECRET"
            },
            "events": [
                "posts.created",
                "posts.updated",
                "posts.deleted",
                "*"
            ]
        },
        {
            "url": "https://example.com/hook",
            "secret": {
                "env": "OTHER_SECRET"
            },
            "events": [
                "members.created"
            ]
        }
