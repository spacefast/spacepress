                "deck": {
                    "type": "file",
                    "bucket": "decks"
                },
                "seo": {
                    "type": "group",
                    "fields": {
                        "kind": {
                            "type": "text",
                            "enum": [
                                "a",
                                "b"
                            ]
                        },
                        "enabled": {
                            "type": "boolean"
                        },
                        "label": {
                            "type": "text",
                            "access": {
                                "read": {
                                    "fn": "posts__field__seo__label__read"
                                }
                            },
                            "showIf": {
                                "OR": [
                                    {
                                        "kind": {
                                            "in": [
                                                "a",
                                                "b"
                                            ]
                                        }
                                    },
                                    {
                                        "enabled": {
                                            "eq": true
                                        }
                                    }
                                ]
                            }
                        }
                    },
                    "showIf": {
                        "status": "published"
                    }
                },
                "items": {
                    "type": "repeater",
                    "fields": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "label": {
                            "type": "text",
                            "showIf": {
                                "enabled": true
                            }
                        }
                    }
                },
                "sections": {
                    "type": "blocks",
