                        "hero": {
                            "kind": {
                                "type": "text"
                            },
                            "label": {
                                "type": "text",
                                "access": {
                                    "update": {
                                        "fn": "posts__field__sections__hero__label__update"
                                    }
                                },
                                "showIf": {
                                    "kind": {
                                        "ne": "hidden"
                                    }
                                }
                            }
                        }
                    }
                },
                "tags": {
                    "type": "select",
                    "multiple": true,
                    "enum": [
                        "news",
                        "guide"
                    ],
                    "localized": true
                },
                "meta": {
                    "type": "json",
                    "localized": true
                },
                "status": {
                    "type": "text",
                    "notNull": true,
