{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"color": { "palette": [ { "slug": "accent", "name": "Accent", "color": "#1f4d3a" } ] },
		"layout": { "contentSize": "40rem", "wideSize": "64rem" }
	},
	"styles": {
		"color": { "background": "#ff00aa", "text": "#00ffaa" },
		"elements": {
			"link": { "color": { "text": "#aa00ff" } },
			"h1": { "typography": { "fontSize": "77px" } }
		},
		"blocks": { "core/paragraph": { "typography": { "lineHeight": "3.21" } } },
		"css": ".loud-theme-css { top: 1px; }"
	}
}
